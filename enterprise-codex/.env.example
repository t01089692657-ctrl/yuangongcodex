# Example configuration. RECOMMENDED: run `scripts/setup.sh` to generate a real
# .env with strong random secrets instead of hand-editing this file.
# Comments must be on their OWN line (not after a value).

# --- Gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Base URL employees' Codex is pointed at (use your reachable HTTPS URL in prod):
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080

# COMPLIANT upstream = your company's OWN OpenAI/Azure endpoint + key.
# Do NOT point this at pooled personal ChatGPT/Codex subscription accounts.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-your-company-openai-key
CODEX_MODEL=gpt-5-codex

# --- Secrets (generate with: openssl rand -hex 32) ---
# The gateway REFUSES TO BOOT when DEMO_MODE is not true and any secret below is
# a placeholder/too short. Replace all four with strong random values.
ADMIN_TOKEN=change-me-admin-token
ADMIN_SESSION_SECRET=change-me-admin-session-secret
SSO_SHARED_SECRET=change-me-sso-secret
FEISHU_WEBHOOK_SECRET=change-me-feishu-secret

# --- Manager backend ---
# DEMO_MODE=true enables the anonymous mock login (trusted networks only).
DEMO_MODE=false
# COOKIE_SECURE: keep true behind HTTPS; set false only for local http dev.
COOKIE_SECURE=true
ADMIN_SESSION_TTL_SECONDS=3600
# Reject stale/replayed offboarding webhooks older than this many seconds:
WEBHOOK_MAX_SKEW_SECONDS=300
SSO_ASSERTION_TTL_SECONDS=120

# --- Feishu / Lark SSO (real login) ---
# Create an app at open.feishu.cn, grant the email scope, register the redirect
# URI. Leave APP_ID/SECRET blank to use only the offline mock login.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8080/auth/feishu/callback
# Endpoints default to real Feishu; override only to point at a mock/self-host:
# FEISHU_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
# FEISHU_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
# FEISHU_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
# FEISHU_OAUTH_SCOPE=contact:user.employee_id:readonly contact:user.email:readonly

# --- Keys ---
KEY_PREFIX=sk-comp-
# 0 = opaque non-expiring key (revoke by flipping active); or set a TTL in seconds:
KEY_TTL_SECONDS=0

# --- Client (employee machines) ---
GATEWAY_URL=http://127.0.0.1:8080
# Managed config dir; keeps company config isolated from the user's own ~/.codex:
CODEX_HOME=~/.codex-managed
# Path to the bundled codex binary in the real client:
CODEX_BIN=
