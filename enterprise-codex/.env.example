# --- Gateway ---------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080     # HTTPS gateway URL in production

# COMPLIANT upstream = your company's OWN OpenAI/Azure endpoint + key.
# Do NOT point this at pooled personal ChatGPT/Codex subscription accounts.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-your-company-openai-key

ADMIN_TOKEN=change-me-admin-token
FEISHU_WEBHOOK_SECRET=change-me-feishu-secret
WEBHOOK_MAX_SKEW_SECONDS=300          # reject stale/replayed offboarding webhooks

# SSO assertion signing secret (demo). In production, DELETE this and verify a
# real OIDC id_token via the IdP's JWKS instead of an HMAC-signed assertion.
SSO_SHARED_SECRET=change-me-sso-secret
SSO_ASSERTION_TTL_SECONDS=120

KEY_PREFIX=sk-comp-
KEY_TTL_SECONDS=0            # 0 = opaque non-expiring key (revoke by flipping active)
CODEX_MODEL=gpt-5-codex

# --- Client ----------------------------------------------------------
GATEWAY_URL=http://127.0.0.1:8080
CODEX_HOME=~/.codex-managed  # managed config dir; keeps company config isolated
CODEX_BIN=                   # path to the bundled codex binary in the real client
